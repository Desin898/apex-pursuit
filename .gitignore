# dependencies and builds (the playable game ships prebuilt in play/)
node_modules/
dist/
# logs and local files
*.log
npm-debug.log*
.DS_Store
Thumbs.db
.env
.env.*
# cloudflared, downloaded by server/host.mjs when hosting over the internet
tools/bin/

# 4D.1: personal music packs (tools/music-pack.py) never go into the public repository
play/music/
dist/music/

# 4.6: the car pack in play/cars/ ships with the game. Converted model files are rebuilt from
# the source model, so they stay out; cars-src/ keeps only each car's rules and description.
dist/cars/
play/cars/*.carpack.json
cars-src/**/*.glb
cars-src/**/*.blend
